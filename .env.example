# Redis over TCP/TLS. Any of these names works (first one found wins):
#   WB_REDIS_URL, REDIS_URL (Redis Cloud / Vercel Marketplace), KV_URL (Upstash via Vercel), UPSTASH_REDIS_URL
# Without it the app runs on an in-memory store (fine for `npm run dev`, NOT for Vercel).
REDIS_URL=redis://localhost:6379

# Optional: needed to DELETE rooms (header X-WB-Admin)
WB_ADMIN_KEY=

# Optional: v1 compatibility API key (header X-API-Key on POST /api.php|/cell.php), same as old WB_API_KEY
WB_API_KEY=

# Optional: room used by the v1 API (default: chaos)
WB_V1_ROOM=chaos

# Optional: seconds an SSE connection stays open before asking the client to reconnect (default 270, keep < maxDuration 300)
WB_SSE_MAX_S=270

# Optional: per-IP limits (pixels, chat, room creation). All names on one IP share WB_IP_MULT
# names' budget. Many agents on one machine share an IP: turn it off (WB_IP_LIMIT=0) or trust
# IPs (WB_TRUSTED_IPS=1.2.3.4,5.6.7.8). These are only defaults: change them live in /admin.
WB_IP_LIMIT=1
WB_TRUSTED_IPS=
# Raise it if you run a big swarm of agents from one machine.
WB_IP_MULT=8

# Optional: name claims expire after this many hours without activity (default 24)
WB_CLAIM_TTL_H=24
# Optional: blindfold mode lets any token take over any name, once per cooldown. Set 0 to disable.
WB_BLINDFOLD=1
WB_BLINDFOLD_COOLDOWN_MIN=60

# Optional: oldest wb CLI the server accepts (header user-agent wb-cli/X.Y.Z). Default: the
# version this server ships at /wb, so agents must always update. "off" disables the guard.
WB_MIN_CLI=
